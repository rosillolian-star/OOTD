<resources>
    <style name="Theme.OOTD" parent="android:Theme.Material.NoActionBar">
        <!-- Dark system window background to prevent white launch flash on Android 12+ -->
        <item name="android:windowBackground">#111111</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:statusBarColor">#111111</item>
        <item name="android:navigationBarColor">#111111</item>

        <!-- Android 12+ SplashScreen system window configuration -->
        <item name="android:windowSplashScreenBackground">#111111</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
